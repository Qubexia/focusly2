{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "webpack": false,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [{ "include": "modules/legal/pages/*.html", "outDir": "dist" }],
    "watchAssets": true
  },
  "entryFile": "main",
  "monorepo": false
}
